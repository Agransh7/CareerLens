{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CareerLens: run server",
      "type": "shell",
      "command": "python",
      "args": ["app.py"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".*", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "CareerLens is running at",
          "endsPattern": "CareerLens is running at"
        }
      }
    },
    {
      "label": "CareerLens: commit and push",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/push.ps1"],
      "problemMatcher": []
    }
  ]
}
