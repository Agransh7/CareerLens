# Copy this file to .env and add your Google AI Studio Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
# Models are tried in order if a request fails. You can edit the fallback order.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash
# Optional; defaults to 8080.
PORT=8080
 
